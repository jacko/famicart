set_global_assignment -name FAMILY MAX3000A
set_global_assignment -name DEVICE "EPM3064ATC44-10"
set_global_assignment -name TOP_LEVEL_ENTITY axrom
set_global_assignment -name ORIGINAL_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name PROJECT_CREATION_TIME_DATE "23:11:20  SEPTEMBER 12, 2023"
set_global_assignment -name LAST_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR "-1"
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name EDA_DESIGN_ENTRY_SYNTHESIS_TOOL Custom
set_global_assignment -name EDA_INPUT_DATA_FORMAT "VERILOG HDL" -section_id eda_design_synthesis
set_global_assignment -name VERILOG_FILE axrom.v
set_global_assignment -name MAX7000_DEVICE_IO_STANDARD "3.3-V LVTTL"
set_global_assignment -name DEVICE_FILTER_PIN_COUNT 44
set_global_assignment -name DEVICE_FILTER_SPEED_GRADE 10
set_location_assignment PIN_39 -to romsel
set_location_assignment PIN_38 -to cpu_rw
set_location_assignment PIN_40 -to m2
set_location_assignment PIN_2 -to cpu_data[0]
set_location_assignment PIN_3 -to cpu_data[1]
set_location_assignment PIN_5 -to cpu_data[2]
set_location_assignment PIN_6 -to cpu_data[3]
set_location_assignment PIN_42 -to cpu_data[4]
set_location_assignment PIN_18 -to prg_addr[15]
set_location_assignment PIN_19 -to prg_addr[16]
set_location_assignment PIN_20 -to prg_addr[17]
set_location_assignment PIN_21 -to ciram_a10
set_location_assignment PIN_22 -to prg_ce
set_location_assignment PIN_23 -to prg_oe
set_location_assignment PIN_25 -to prg_we
# set_location_assignment PIN_34 -to power_led